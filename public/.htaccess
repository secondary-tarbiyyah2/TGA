# Tarbiyyah Global Academy — MAIN DOMAIN static export document root
# (globalacademy.tarbiyyah.co.uk). The authenticated /learn portal used to be
# a path under this same domain; it now lives on its own subdomain
# (learn.tarbiyyah.co.uk, its own document root, its own
# .htaccess — see deploy/learn-subdomain.htaccess) for real browser-origin
# isolation, so an XSS bug here can never read the portal's session/
# localStorage or make credentialed requests against it. See SETUP.md,
# "Moving /learn to its own subdomain".
#
# Copied verbatim by `next build` (output: "export") into out/, then into
# out-main/ by scripts/split-static-export.mjs, so this ships with every
# deploy of the main site specifically (NOT the /learn subdomain, which gets
# its own .htaccess instead). Mirrors the legacy-static/.htaccess rules.

DirectoryIndex index.html

# No directory browsing.
Options -Indexes

RewriteEngine On
RewriteOptions IgnoreInherit

# /portal is superseded by /learn, which is now on its own subdomain —
# redirect straight there at the server level (not a JS/meta-refresh page)
# so this works even pre-JS and for anything that had the old URL bookmarked
# or indexed. Doesn't carry an auth token in its URL, so a plain server-side
# 301 is safe here (contrast with the /learn/* bridge page below).
#
# /staff is DELIBERATELY NOT redirected yet, unlike /portal — StaffApp.tsx
# (booking/availability management) has no replacement live in /learn yet
# (/learn/admin/admissions was still a stub when this redirect was first
# added, which would have left every staff member with no way to manage
# bookings at all). Re-add `RewriteRule ^staff(/.*)?$ .../login/ [R=301,L]`
# here, and only then retire src/app/(marketing)/staff/ and StaffApp.tsx,
# once /learn/admin/admissions' "My availability"/"All staff" views are
# confirmed working for a real staff member — see SETUP.md.
RewriteRule ^portal(/.*)?$ https://learn.tarbiyyah.co.uk/login/ [R=301,L]

# ── PRE-LAUNCH (October 2026) ────────────────────────────────────────────────
# Two separate sites from the same files, chosen by the address:
#
# 1. RewriteCond %{HTTP_HOST} !^preview\. [NC]LIC  https://globalacademy.tarbiyyah.co.uk
#    Always the simple holding site, for everyone (staff included): "/"
#    (register interest), /term-dates/, /fees/ and /curriculum/ (subjects),
#    plus the legal pages and booking links already emailed to families.
#    Every other page address redirects to "/".
#
# 2. STAFF PREVIEW  https://preview.tarbiyyah.co.uk
#    The full website as it will be when published. Private: opening
#    https://preview.tarbiyyah.co.uk/?key=<key> once lets that browser use it
#    for good (renewed on every visit) and also opens the staff-only portal (learn.tarbiyyah.co.uk).
#    The public address never looks at this cookie, so it is never affected. Without it, visitors get a short "staff only"
#    page. Every response is noindex and its robots.txt disallows everything,
#    so it never appears in search results.
#    Needs, once: a proxied "preview" DNS record in Cloudflare and the
#    preview.tarbiyyah.co.uk subdomain in cPanel using THIS site's folder as
#    its document root (SETUP.md, "Staff preview site").
#
# __PREVIEW_KEY__ is replaced at deploy time (deploy-site.yml) with
# deploy/preview-key.txt or the PREVIEW_KEY secret; change it and redeploy to
# cut off old links. Redirects name https:// explicitly because Cloudflare
# talks to this server over http.
#
# TO OPEN THE FULL SITE: delete this block, set PRELAUNCH = false in
# src/lib/prelaunch.ts, then redeploy.

# Old staff links on the public address (?preview=...) just clear the old
# cookie: the public address is the holding site for everyone.
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteCond %{QUERY_STRING} (^|&)preview= [NC]
RewriteRule ^(.*)$ https://globalacademy.tarbiyyah.co.uk/$1? [CO=tga_preview:off:globalacademy.tarbiyyah.co.uk:-1:/:1:1,CO=tga_preview_ui:0:globalacademy.tarbiyyah.co.uk:-1:/:1:0,R=302,L]

# ── 2. Staff preview site ──
RewriteCond %{HTTP_HOST} ^preview\. [NC]
RewriteCond %{QUERY_STRING} (^|&)key=__PREVIEW_KEY__(&|$)
RewriteRule ^(.*)$ https://preview.tarbiyyah.co.uk/$1? [CO=tga_staff:__PREVIEW_KEY__:.tarbiyyah.co.uk:576000:/:1:1,CO=tga_preview_ui:1:preview.tarbiyyah.co.uk:576000:/:1:0,R=302,L]
# Staff access never runs out while it is used: each page visit with a valid
# staff cookie renews it for another 400 days (the longest browsers allow).
RewriteCond %{HTTP_HOST} ^preview\. [NC]
RewriteCond %{HTTP_COOKIE} (^|;\s*)tga_staff=__PREVIEW_KEY__(;|$)
RewriteCond %{REQUEST_URI} (/|\.html)$
RewriteRule ^ - [CO=tga_staff:__PREVIEW_KEY__:.tarbiyyah.co.uk:576000:/:1:1,CO=tga_preview_ui:1:preview.tarbiyyah.co.uk:576000:/:1:0]
RewriteCond %{HTTP_HOST} ^preview\. [NC]
RewriteRule ^robots\.txt$ /robots-preview.txt [L]
RewriteCond %{HTTP_HOST} ^preview\. [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)tga_staff=__PREVIEW_KEY__(;|$)
RewriteCond %{REQUEST_URI} !^/(staff-only\.html|robots-preview\.txt|favicon\.(ico|png|svg)|brand/ga-wordmark\.png)$
RewriteRule ^ /staff-only.html [L]

# ── 1. Public holding site ── (never applies to the preview address)
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/(coming-soon|legal|manage-booking)(/|$)
RewriteCond %{REQUEST_URI} !^/(term-dates|fees|curriculum)/?$
RewriteCond %{REQUEST_URI} !^/(_next|brand|learn|studio|staff|policies|prospectus)/
RewriteCond %{REQUEST_URI} !\.(php|png|jpe?g|webp|gif|svg|ico|webmanifest|xml|ics|js|css|woff2?|json|pdf|docx|map)$
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteRule ^ https://globalacademy.tarbiyyah.co.uk/ [R=302,L]
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteRule ^(index\.html)?$ /coming-soon/index.html [L]
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteRule ^term-dates/?$ /coming-soon/term-dates/index.html [L]
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteRule ^fees/?$ /coming-soon/fees/index.html [L]
RewriteCond %{HTTP_HOST} !^preview\. [NC]
RewriteRule ^curriculum/?$ /coming-soon/subjects/index.html [L]

<IfModule mod_headers.c>
  # The staff preview site never appears in search results.
  <If "%{HTTP_HOST} =~ /^preview\./i">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
  # HTML is never reused from a cache (the same files serve two sites).
  <If "%{REQUEST_URI} =~ m#(/|\.html|\.txt)$#">
    Header always set Cache-Control "no-store"
  </If>

  # Baseline security headers for every response on both hosts. No full
  # Content-Security-Policy here: the pages frame CMS-chosen URLs (open
  # evening booking widget, lesson/recording videos) whose origins change,
  # and a policy that breaks those silently is worse than none; the /learn
  # subdomain, which frames nothing external, carries a strict CSP of its own
  # (deploy/learn-subdomain.htaccess). frame-ancestors still stops this site
  # being framed by others (clickjacking), the only CSP directive that matters
  # for a static brochure site.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Policy documents (/policies/<slug>.pdf or .docx) are served live by
# policy.php, which streams whatever is currently uploaded in the admin
# portal and falls back to the PDF bundled in /policies/ — so a policy edit
# is live immediately, with no rebuild, on an address that stays on this
# domain. See deploy/policy.php.
# Policies were renumbered in September 2026 (SMSC folded into others), so
# old addresses forward to the same policy's new one.
# The Academy starts at Year 1; the old key-stage URL redirects.
RewriteRule ^curriculum/reception-year-2/?$ /curriculum/year-1-2/ [R=301,L]
# Pages of the old static site (legacy-static/). The FTP deploy never deletes
# files on the server, so copies uploaded before the Next.js site may still
# be there, still offering Reception, A Levels and a January 2027 start.
# Send them to the current pages instead. (This site emits <route>/index.html,
# so none of these names is a real page of the current build.)
RewriteRule ^faq\.html$ /faqs/ [R=301,L]
RewriteRule ^admissions\.html$ /admissions/ [R=301,L]
RewriteRule ^register\.html$ /admissions/ [R=301,L]
RewriteRule ^offer\.html$ /curriculum/ [R=301,L]
RewriteRule ^why\.html$ /about/ [R=301,L]
RewriteRule ^trust\.html$ /about/ [R=301,L]
RewriteRule ^policies/17-rshe\.pdf$ /policies/17-relationships-sex-and-health-education.pdf [R=301,L]
RewriteRule ^policies/19-careers\.pdf$ /policies/18-careers-education-and-guidance.pdf [R=301,L]
RewriteRule ^policies/25-admissions\.pdf$ /policies/24-admissions.pdf [R=301,L]
RewriteRule ^policies/26-fees\.pdf$ /policies/25-fees.pdf [R=301,L]
RewriteRule ^policies/27-concerns-and-complaints\.pdf$ /policies/26-concerns-and-complaints.pdf [R=301,L]
RewriteRule ^policies/29-data-protection\.pdf$ /policies/28-data-protection.pdf [R=301,L]
RewriteRule ^policies/30-equality-diversity-and-accessibility\.pdf$ /policies/29-equality-diversity-and-accessibility.pdf [R=301,L]
RewriteRule ^policies/([a-z0-9][a-z0-9-]*)\.(pdf|docx)$ /policy.php?slug=$1&ext=$2 [L,QSA]

# Sanity Studio (out/studio, built separately by `npm run sanity:build` — see
# README) is a client-side-routed single-page app: any /studio/* request that
# isn't a real file must fall back to /studio/index.html so its own router
# can handle the path.
RewriteCond %{REQUEST_URI} ^/studio/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /studio/index.html [L]

# /learn no longer exists under this domain at all — every route that used
# to live here now lives at the same path under
# https://learn.tarbiyyah.co.uk instead. Real invite/
# password-reset links already sent to real people before this migration
# point at /learn/login/invite on THIS domain, though, so this can't just
# 404: any /learn/* request that isn't a real file (the /learn folder here
# now holds only the bridge page itself) falls back to /learn/index.html,
# a small client-side redirect (see deploy/learn-bridge.html and
# scripts/split-static-export.mjs) that reads window.location.hash itself
# and carries it over to the new origin — deliberately NOT a server-side
# 301 for this one, because Supabase's invite/recovery links carry the auth
# token in the URL fragment, which a plain redirect can't be trusted to
# preserve without doubt.
RewriteCond %{REQUEST_URI} ^/learn
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /learn/index.html [L]

# Caching. There's no CDN in front of this host, so these headers are the
# only caching the site gets — worth setting deliberately rather than
# leaving to Apache's defaults (which send no explicit Cache-Control at all,
# so browsers/proxies revalidate every asset on every visit).
#
# /_next/static/* is content-hashed by Next.js (a changed file gets a new
# filename), so it's safe to cache for a year and mark immutable — a
# redeploy never needs to invalidate it, it just starts referencing new
# hashed paths from the new HTML.
#
# Other static assets under public/ (images, fonts, the favicon, brand
# logos) are NOT hashed — the same filename can be replaced by a future
# deploy — so they get a short, safely-revalidated cache instead of a year.
#
# HTML documents (and the sitemap/robots/ics feeds) are deliberately left
# uncached here: this is a plain FTP deploy with no cache purge step, so an
# HTML page must be free to change on the next deploy and be picked up
# immediately rather than served stale from a visitor's cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/learn#">
    Header set Cache-Control "no-store"
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#\.(?:jpg|jpeg|png|webp|gif|svg|ico|woff2?|ttf|otf)$#">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </ElseIf>
</IfModule>

# Don't expose dotfiles (e.g. this .htaccess) to the web.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Keep the email config out of the web (it holds the Brevo API key).
<FilesMatch "^register\.config\.php$">
  Require all denied
</FilesMatch>

# The mailer helper isn't meant to be requested directly.
<FilesMatch "^_mailer\.php$">
  Require all denied
</FilesMatch>

# The send log records applicant email addresses — never expose it.
<FilesMatch "^register\.log$">
  Require all denied
</FilesMatch>
