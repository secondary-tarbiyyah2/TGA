{"pages":{"601":[[103,1,"وَٱلۡعَصۡرِ"],[103,2,"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ"],[103,3,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ"],[104,1,"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ"],[104,2,"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ"],[104,3,"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"],[104,4,"كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"],[104,5,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"],[104,6,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"],[104,7,"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"],[104,8,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ"],[104,9,"فِي عَمَدٖ مُّمَدَّدَةِۭ"],[105,1,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ"],[105,2,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ"],[105,3,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ"],[105,4,"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ"],[105,5,"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ"]],"602":[[106,1,"لِإِيلَٰفِ قُرَيۡشٍ"],[106,2,"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ"],[106,3,"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ"],[106,4,"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ"],[107,1,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"],[107,2,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"],[107,3,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"],[107,4,"فَوَيۡلٞ لِّلۡمُصَلِّينَ"],[107,5,"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"],[107,6,"ٱلَّذِينَ هُمۡ يُرَآءُونَ"],[107,7,"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"],[108,1,"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ"],[108,2,"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ"],[108,3,"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ"]],"603":[[109,1,"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ"],[109,2,"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ"],[109,3,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"],[109,4,"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ"],[109,5,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"],[109,6,"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ"],[110,1,"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ"],[110,2,"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا"],[110,3,"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا"],[111,1,"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ"],[111,2,"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ"],[111,3,"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ"],[111,4,"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ"],[111,5,"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ"]],"604":[[112,1,"قُلۡ هُوَ ٱللَّهُ أَحَدٌ"],[112,2,"ٱللَّهُ ٱلصَّمَدُ"],[112,3,"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ"],[112,4,"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ"],[113,1,"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ"],[113,2,"مِن شَرِّ مَا خَلَقَ"],[113,3,"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"],[113,4,"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ"],[113,5,"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"],[114,1,"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ"],[114,2,"مَلِكِ ٱلنَّاسِ"],[114,3,"إِلَٰهِ ٱلنَّاسِ"],[114,4,"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ"],[114,5,"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ"],[114,6,"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ"]]}}