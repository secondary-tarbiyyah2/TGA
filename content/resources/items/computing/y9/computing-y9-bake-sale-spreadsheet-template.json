   "h": "Absolute references"
  },
  {
   "model": {
    "title": "Add 20% of each takings figure to a charity column, with 20% in F1",
    "parts": [
     {
      "text": "Put 0.2 in F1"
     },
     {
      "text": "In E2 type =D2*$F$1"
     },
     {
      "text": "Copy down to E4"
     },
     {
      "text": "$F$1 stays fixed; D2 changes to D3, D4"
     },
     {
      "label": "Why it works",
      "text": "E2 = 12.00, E3 = 10.00, E4 = 6.00"
     }
    ]
   }
  },
