     "q": "How many states do 5 bits give?",
     "options": [
      "32",
      "10",
      "31",
      "25"
     ],
     "a": "A) 32. 2^5 = 32; 31 is the largest value, not the number of states.",
     "marks": 1
    },
    {
     "q": "11111111 in two's complement is ...",
     "options": [
      "−1",
      "255",
      "−127",
      "−128"
     ],
     "a": "A) −1. −128 + 127 = −1.",
     "marks": 1
    },
    {
     "q": "Which sum overflows 8 bits (unsigned)?",
     "options": [
      "180 + 90",
      "100 + 100",
      "127 + 1",
      "0 + 255"
     ],
     "a": "A) 180 + 90. 180 + 90 = 270 > 255.",
     "marks": 1
    },
    {
     "q": "01011100 in hex is ...",
     "options": [
      "5C",
      "92",
      "C5",
      "5B"
