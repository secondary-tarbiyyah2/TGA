    {
     "q": "P(rain) = 0.3 each day, independent. P(rain both days)?",
     "a": "0.09"
    },
    {
     "q": "Bag of 4 green, 6 yellow. Two taken without replacement. P(both yellow)?",
     "a": "1/3",
     "model": "6/10 × 5/9 = 30/90. 30/90 = 1/3."
    },
    {
     "q": "P(both green)?",
     "a": "12/90 = 2/15"
    },
    {
     "q": "P(at least one green)?",
     "a": "1 - 1/3 = 2/3"
    }
