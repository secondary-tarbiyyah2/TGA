  {
   "questions": [
    {
     "q": "P(a bus is late) = 0.2 each day, independently. Draw a tree for Monday and Tuesday. Find P(late both days), P(late on exactly one day), P(not late either day).",
     "a": "0.04; 0.32; 0.64",
     "model": "Late, late: 0.2 × 0.2 = 0.04. Exactly one: 0.2 × 0.8 + 0.8 × 0.2 = 0.16 + 0.16 = 0.32. Check: 0.04 + 0.32 + 0.64 = 1."
    },
    {
     "q": "Use the bus probabilities: P(late at least once)?",
     "a": "1 - 0.64 = 0.36"
    },
    {
     "q": "A coin is flipped 3 times. P(exactly two heads)?",
     "a": "3 paths × 1/8 = 3/8"
    },
    {
     "q": "A box has 5 dates and 3 figs. Two are taken without replacement. Draw the tree; find P(two dates), P(two figs), P(one of each).",
     "a": "20/56 = 5/14; 6/56 = 3/28; 30/56 = 15/28",
     "model": "Date, date: 5/8 × 4/7 = 20/56. One of each: 5/8 × 3/7 + 3/8 × 5/7 = 15/56 + 15/56 = 30/56. Check: 20 + 6 + 30 = 56."
    },
    {
     "q": "In the same box, P(at least one fig)?",
     "a": "1 - 20/56 = 36/56 = 9/14"
    },
    {
     "q": "A bag has n counters, 2 of them red. Two are taken without replacement and P(both red) = 1/15. Find n.",
     "a": "2/n × 1/(n - 1) = 1/15: n(n - 1) = 30, so n = 6"
    }
   ]
