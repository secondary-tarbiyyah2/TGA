      "strands": [
        {
          "strand": "Expressive Arts and Design",
          "statements": [
            "Creating with materials: safely use and explore materials, tools and techniques; try colour, design, texture, form, function",
            "Share creations and explain the process used",
            "Use props and materials when role playing characters in stories",
            "Being imaginative and expressive: invent, adapt and recount stories; sing and perform with others"
          ]
        },
        {
          "strand": "Physical Development: Fine Motor Skills (supports drawing and making)",
          "statements": [
            "Use a range of small tools, including scissors and paint brushes",
            "Begin to show accuracy and care when drawing"
          ]
        }
      ]
    },
    {
      "ks": "KS1",
      "years": "Years 1 to 2",
      "strands": [
        {
          "strand": "Making and techniques",
          "statements": [
            "Use a range of materials creatively to design and make products",
            "Use drawing, painting and sculpture to share ideas, experiences and imagination",
            "Develop techniques in colour, pattern, texture, line, shape, form and space"
          ]
        },
        {
          "strand": "Artists, craft makers and designers",
          "statements": [
            "Learn about a range of artists, craft makers and designers",
            "Describe the differences and similarities between different practices",
            "Link this learning to their own work"
          ]
        }
      ]
    },
    {
      "ks": "KS2",
      "years": "Years 3 to 6",
      "strands": [
        {
          "strand": "Making and techniques",
          "statements": [
            "Create sketchbooks to record observations and review and revisit ideas",
            "Improve mastery of art and design techniques, including drawing, painting and sculpture",
            "Use a range of materials, such as pencil, charcoal, paint and clay"
          ]
        },
        {
          "strand": "Great artists, architects and designers",
          "statements": [
            "Learn about great artists, architects and designers in history"
          ]
        }
      ]
    },
    {
      "ks": "KS3",
      "years": "Years 7 to 9",
