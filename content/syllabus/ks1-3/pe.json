{
  "kind": "syllabus",
  "subject": "Physical Education",
  "slug": "pe",
  "framework": "National Curriculum in England (2013, in force from 2014): Physical education programmes of study, key stages 1 to 4; Early Years Foundation Stage (Physical Development) for Reception",
  "status": "Verified",
  "statusNote": "The National Curriculum physical education programme of study (purpose, aims, attainment target, KS1 to KS4 content including swimming) was read on the gov.uk programme of study page, and the EYFS Physical Development early learning goals were read from the EYFS statutory framework effective 1 September 2026. Statutory statements are by key stage; the year allocation is a recommended sequence. School units marked inSchoolLessons come from the school's PE lesson files, which are framed as home-based, no-equipment and no-contact lessons; other units are recommended additions. Year 10 and 11 core PE lessons exist but are not in this year map, which stops at Year 9. The UK Chief Medical Officers' physical activity guidelines cited in the school content were not opened.",
  "sources": [
    {
      "title": "National curriculum in England: physical education programmes of study",
      "url": "https://www.gov.uk/government/publications/national-curriculum-in-england-physical-education-programmes-of-study/national-curriculum-in-england-physical-education-programmes-of-study"
    },
    {
      "title": "Early years foundation stage statutory framework for group and school-based providers (from September 2026)",
      "url": "https://assets.publishing.service.gov.uk/media/6a5f8e4fb00f3323bf1a23a1/EYFS_group_and_school_based_from_September_2026.pdf"
    }
  ],
  "purpose": [
    "A high-quality physical education helps all pupils succeed in competitive sport and physically demanding activity.",
    "It builds physical confidence that supports health and fitness.",
    "Competition builds character and values such as fairness and respect.",
    "Online pupils complete activity at home or locally; the school's lessons are no-equipment and no-contact (the Curriculum Policy refers to 'PE (at home)')."
  ],
  "keyStages": [
    {
      "ks": "EYFS",
      "years": "Reception",
      "strands": [
        {
          "strand": "Physical Development",
          "statements": [
            "Gross motor: move safely and energetically with strength, balance and coordination",
            "Run, jump, hop and climb with awareness of space and others",
            "Fine motor: hold a pencil with a tripod grip and use small tools with care"
          ]
        }
      ]
    },
    {
      "ks": "KS1",
      "years": "Years 1 to 2",
      "strands": [
        {
          "strand": "Fundamental movement",
          "statements": [
            "Master basic movements such as running, jumping, throwing and catching",
            "Develop balance, agility and coordination",
            "Begin to apply these in a range of activities"
          ]
        },
        {
          "strand": "Games and dance",
          "statements": [
            "Take part in team games using simple attacking and defending tactics",
            "Perform dances using simple movement patterns",
            "Take part in competitive and co-operative activities"
          ]
        }
      ]
    },
    {
      "ks": "KS2",
      "years": "Years 3 to 6",
      "strands": [
        {
          "strand": "Games and athletics",
          "statements": [
            "Use running, jumping, throwing and catching in isolation and in combination",
            "Play competitive games, modified where appropriate, applying basic principles",
            "Develop flexibility, strength, technique, control and balance, for example through athletics and gymnastics"
          ]
        },
        {
          "strand": "Dance, outdoor activity and performance",
          "statements": [
            "Perform dances using a range of movement patterns",
            "Take part in outdoor and adventurous activity challenges, individually and in teams",
            "Compare performances with previous ones to achieve a personal best"
          ]
        },
        {
          "strand": "Swimming and water safety",
          "statements": [
            "Taught in KS1 or KS2: swim at least 25 metres confidently and proficiently",
            "Use a range of strokes effectively",
            "Perform safe self-rescue in different water-based situations"
          ]
        }
      ]
    },
    {
      "ks": "KS3",
      "years": "Years 7 to 9",
      "strands": [
        {
          "strand": "Games, gymnastics and athletics",
          "statements": [
            "Use a range of tactics and strategies to overcome opponents in team and individual games",
            "Develop technique and improve performance in competitive sports such as athletics and gymnastics",
            "Analyse performance compared with previous ones to achieve a personal best"
          ]
        },
        {
          "strand": "Dance, outdoor activity and lifelong participation",
          "statements": [
            "Perform dances using advanced dance techniques in a range of styles",
            "Take part in outdoor and adventurous activities that develop teamwork, trust and problem solving",
            "Take part in competitive sports and activities outside school through community links or sports clubs"
          ]
        }
      ]
    },
    {
      "ks": "KS4",
      "years": "Years 10 to 11",
      "strands": [
        {
          "strand": "Core PE (non-examined)",
          "statements": [
            "Tackle complex and demanding physical activities that build personal fitness and a healthy lifestyle",
            "Develop and refine tactics and strategies for team and individual games",
            "Improve technique in competitive sports or other activities such as dance"
          ]
        },
        {
          "strand": "Outdoor activity and lifelong participation",
          "statements": [
            "Take part in further outdoor and adventurous challenges in different environments",
            "Evaluate performances compared with previous ones to achieve a personal best in a range of activities",
            "Continue to take part regularly in competitive sport and other activities outside school"
          ]
        }
      ]
    }
  ],
