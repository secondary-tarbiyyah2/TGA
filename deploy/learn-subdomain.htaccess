# Document root for learn.tarbiyyah.co.uk — the ENTIRE
# authenticated /learn portal, promoted from a path under the main domain to
# its own subdomain for real browser-origin isolation (see SETUP.md, "Moving
# /learn to its own subdomain", and the top-level public/.htaccess). Built
# by scripts/split-static-export.mjs from the same `next build` output as
# the main site; deployed by the second FTP step in deploy-site.yml.
#
# Unlike the main domain's .htaccess, EVERYTHING here is the portal, so the
# header block below applies unconditionally (no REQUEST_URI path match
# needed — contrast with public/.htaccess's old `<If ... =~ m#^/learn#>`
# gate, which no longer exists because there's no longer a public sibling
# path to gate against on this origin).

DirectoryIndex index.html

# No directory browsing.
Options -Indexes

RewriteEngine On
RewriteOptions IgnoreInherit

# ── PRE-LAUNCH: STAFF ONLY ──────────────────────────────────────────────────
# The portal is restricted to staff until launch. Opening
# https://learn.tarbiyyah.co.uk/?key=<key> (or the staff preview link for the
# website, https://preview.tarbiyyah.co.uk/?key=<key>) sets a cookie (renewed on every visit, so it does not run out) for
# *.tarbiyyah.co.uk, so one staff link opens both. Without it, every address
# shows a short "staff only" page. __PREVIEW_KEY__ is replaced at deploy time
# (deploy-site.yml) from deploy/preview-key.txt or the PREVIEW_KEY secret.
# TO OPEN THE PORTAL: delete this block and redeploy.
RewriteCond %{QUERY_STRING} (^|&)key=__PREVIEW_KEY__(&|$)
RewriteRule ^(.*)$ https://learn.tarbiyyah.co.uk/$1? [CO=tga_staff:__PREVIEW_KEY__:.tarbiyyah.co.uk:576000:/:1:1,R=302,L]
# Renew the staff cookie on every page visit, so access never runs out while used.
RewriteCond %{HTTP_COOKIE} (^|;\s*)tga_staff=__PREVIEW_KEY__(;|$)
RewriteCond %{REQUEST_URI} (/|\.html)$
RewriteRule ^ - [CO=tga_staff:__PREVIEW_KEY__:.tarbiyyah.co.uk:576000:/:1:1]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)tga_staff=__PREVIEW_KEY__(;|$)
RewriteCond %{REQUEST_URI} !^/(staff-only\.html|robots\.txt|favicon\.(ico|png|svg)|brand/ga-wordmark\.png)$
RewriteRule ^ /staff-only.html [L]
# ── end PRE-LAUNCH ──────────────────────────────────────────────────────────

# Never cached (by any proxy/browser between here and the visitor — there is
# no CDN in front of this host), never indexed, and locked to a CSP with no
# third-party origins at all (no analytics/chat-widget script tags exist
# anywhere under this subdomain, and this header means one couldn't silently
# be added later without it breaking — script-src stays 'self' only, so an
# injected <script src="...evil"> still can't load).
#
# 'self' now means THIS subdomain, not a path under the main domain — the
# whole point of this migration — so no directive value needed to change.
#
# script-src needs 'unsafe-inline' specifically: Next.js's App Router emits
# inline <script> tags in every static page to stream the RSC payload for
# hydration (self.__next_f.push(...)) — this exists in the built HTML
# itself, not something added later, and without it React never finishes
# hydrating. A per-request nonce isn't possible here (this is a static
# export with no server to mint one per request), and a hash-allowlist would
# need to be recomputed and kept in sync with every single build's inline-
# script content — 'unsafe-inline' is the honest trade-off: same-origin-only
# script loading is still enforced, but an XSS that got attacker content
# into the page could now execute inline.
# blob: (and ONLY blob:) is allowed for img/frame/child/object-src so the
# admissions drawer can preview an uploaded PDF/image: the browser fetches the
# private file over connect-src (Supabase), wraps it in a same-origin blob: URL
# and frames that. No other origin may be framed or embedded.
# https://cdnjs.cloudflare.com (and only it) is allowed for script-src and
# connect-src so the homework annotator can load pdf.js and pdf-lib at pinned
# versions (src/lib/learn/pdfLibs.ts); the pdf.js worker is run from a blob: copy
# (worker-src). media-src blob: lets audio/video submissions play in the in-app
# file viewer.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Microphone: the homework audio-note recorder (AudioNoteRecorder) records
  # in-page. Nothing here needs the camera or location.
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
  Header set Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.supabase.co https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:; child-src blob:; object-src blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# The portal installs as an app (app.webmanifest + sw.js at the root).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>

# Don't expose dotfiles (e.g. this .htaccess) to the web.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
