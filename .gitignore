# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# The two deploy-split document roots (see scripts/split-static-export.mjs)
/out-main/
/out-learn/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Sanity CLI local runtime cache (regenerated by sanity dev/build)
.sanity

# PHP form-handler secrets/logs (live on the server, never in git — see
# public/register.config.example.php)
/public/register.config.php
/public/register.log
/public/register.ratelimit.json

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.branches/
supabase/.temp/
/dist/

# Python bytecode (scripts/timetable-solver)
__pycache__/
*.pyc
