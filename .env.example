# Sanity CMS (admin panel). Create a free project at sanity.io, then fill these in.
# Until these are set, every page falls back to bundled placeholder content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Transactional email (register-interest + application forms), via the Brevo HTTPS API.
# Without this set, form submissions succeed in "dev mode" (logged, not actually emailed).
BREVO_API_KEY=
MAIL_FROM_EMAIL=globalacademy@tarbiyyah.co.uk
MAIL_FROM_NAME=Tarbiyyah Global Academy
ADMISSIONS_EMAIL=globalacademy@tarbiyyah.co.uk

# Optional: forward every form submission as JSON to a CRM/Notion webhook.
CRM_WEBHOOK_URL=

# Optional: cookieless analytics (see src/components/Analytics.tsx). Your site's domain, e.g. globalacademy.tarbiyyah.co.uk
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
