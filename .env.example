# These are only needed wherever the site is BUILT (CI, or locally if building on the
# server) — the static export has no runtime environment, so nothing here is read by the
# deployed site itself.

# Sanity CMS (admin panel). Create a free project at sanity.io, then fill these in.
# Until these are set, every page falls back to bundled placeholder content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: cookieless analytics (see src/components/Analytics.tsx). Your site's domain, e.g. globalacademy.tarbiyyah.co.uk
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Form email (register-interest + application forms) is NOT configured here — it's handled
# by public/register.php and public/apply.php on the server, configured via
# public/register.config.php (copy from public/register.config.example.php directly on the
# server; see README.md "Forms & email").
